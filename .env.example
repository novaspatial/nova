# Canonical site origin used for metadata, the sitemap, social tags, and
# search-engine pings. Defaults to the bare production domain when unset;
# override on preview deployments. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nova-spatial.com
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=NovaSpatial <noreply@nova-spatial.com>
# Inbox that receives contact-form submissions. In production, leaving this
# unset stores inquiries in Supabase but skips the email notification.
CONTACT_INBOX_TO=contact@nova-spatial.com
# IndexNow key for best-effort search-engine pings on blog publish/update/takedown.
# Any 8–128 hex chars; served at /indexnow-key.txt. Leave unset to disable pinging
# (dev/preview). Server-only.
INDEXNOW_KEY=your-indexnow-key
# Shared secret for the Vercel Cron purge entrypoint (/api/cron/purge-delivered).
# Vercel sends it as `Authorization: Bearer <value>` on cron invocations; the
# route rejects everything else and fails closed when unset. Server-only.
CRON_SECRET=your-cron-secret
# Content-Security-Policy mode: 'report-only' (default) or 'enforce'. The
# header is compiled into the build, so changing this needs a redeploy —
# it is a staged-rollout lever, not a live kill switch. Violations are
# posted to /api/csp-report and logged either way.
# CSP_MODE=enforce
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Local-only: when 'true', the portal checkout skips Stripe entirely and
# creates projects at $0 already marked as paid. Requires
# SUPABASE_SERVICE_ROLE_KEY (the born-paid insert is a system write since
# the 20260708 insert fence). The code refuses it on Vercel entirely —
# preview included, since preview shares the production database (#45) —
# and it ships commented out so a bulk env import can't arm it by accident.
# To smoke-test checkout on a deploy, use a Stripe test card instead.
# PAYMENTS_DEV_BYPASS=true
# Sentry DSN for error reporting (#59). Unset means every Sentry entry
# point no-ops and errors reach the console only — which is how this
# ships until the project is provisioned. Setting it in the Vercel env is
# the whole activation: no code change, and the CSP's connect-src token
# for the ingest host is derived from this same value at build time.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
